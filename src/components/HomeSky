
// src/components/Sky/HomeSky.tsx
//
// Fundo animado das telas de menu (início, login, perfil): degradê do céu +
// sol/lua + estrelas piscando. Funciona offline (sem imagens da internet) e
// usa o tema da HORA DO DIA do aparelho (noite, amanhecer, dia, entardecer).

import React, { memo, useEffect, useMemo, useRef } from "react";
import { Animated, Dimensions, Easing, StyleSheet, View } from "react-native";
import { LinearGradient } from "expo-linear-gradient";

import { Orb } from "../Game/SkyBackground";
import { SkyTheme, themeForHour } from "../../game/theme";

const { width: W, height: H } = Dimensions.get("window");

/** Tema pela hora atual do aparelho. */
export function currentSkyTheme(): SkyTheme {
  return themeForHour(new Date().getHours());
}

// Estrelas fixas (sem Math.random a cada render)
function makeStars(count: number) {
  let seed = 42;
  const rnd = () => {
    seed = (seed * 16807) % 2147483647;
    return seed / 2147483647;
  };
  return Array.from({ length: count }, () => ({
    x: rnd() * W,
    y: rnd() * H * 0.85,
    size: 1.5 + rnd() * 2,
    group: Math.floor(rnd() * 3),
  }));
}

const HomeSky = memo(function HomeSky({ theme }: { theme?: SkyTheme }) {
  const hourTheme = useMemo(currentSkyTheme, []);
  const t = theme ?? hourTheme;
  const stars = useMemo(() => makeStars(46), []);

  const pulses = useRef([0, 1, 2].map(() => new Animated.Value(0.25))).current;

  useEffect(() => {
    const loops = pulses.map((v, i) =>
      Animated.loop(
        Animated.sequence([
          Animated.timing(v, {
            toValue: 1,
            duration: 1400 + i * 500,
            easing: Easing.inOut(Easing.sin),
            useNativeDriver: true,
          }),
          Animated.timing(v, {
            toValue: 0.25,
            duration: 1400 + i * 500,
            easing: Easing.inOut(Easing.sin),
            useNativeDriver: true,
          }),
        ])
      )
    );
    loops.forEach((l) => l.start());
    return () => loops.forEach((l) => l.stop());
  }, [pulses]);

  return (
    <View pointerEvents="none" style={StyleSheet.absoluteFill}>
      <LinearGradient colors={t.colors} style={StyleSheet.absoluteFill} />
      <Orb theme={t} w={W} h={H} />

      {t.starAlpha > 0 &&
        stars.map((s, i) => (
          <Animated.View
            key={i}
            style={{
              position: "absolute",
              left: s.x,
              top: s.y,
              width: s.size,
              height: s.size,
              borderRadius: s.size,
              backgroundColor: "#fff",
              opacity: Animated.multiply(pulses[s.group], t.starAlpha),
            }}
          />
        ))}

      {/* escurece a parte de baixo para os botões ficarem legíveis */}
      <LinearGradient
        colors={["rgba(0,0,12,0)", "rgba(0,0,12,0.55)", "rgba(0,0,12,0.9)"]}
        locations={[0.25, 0.65, 1]}
        style={StyleSheet.absoluteFill}
      />
    </View>
  );
});

export default HomeSky;
